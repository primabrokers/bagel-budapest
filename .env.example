# Optional. Both values have committed defaults in src/lib/supabaseConfig.ts pointing at this
# app's own Supabase project, so a clean checkout runs and a clean deploy works with no .env at
# all. Set these only to point a build at a DIFFERENT Supabase project — they override the
# defaults at build time.
#
# Never put a service role key in either variable: VITE_* values are inlined into the browser
# bundle, and the service role key bypasses row-level security.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
